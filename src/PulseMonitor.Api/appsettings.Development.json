{
  "ConnectionStrings": {
    "PulseMonitorDb": "Server=localhost;Database=PulseMonitorDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "PulseMonitor": "Debug"
      }
    }
  },
  "Monitoring": {
    "Thresholds": {
      "CpuUsage": 90,
      "MemoryUsage": 90,
      "DiskUsage": 85,
      "ResponseTimeMs": 400
    }
  }
}
