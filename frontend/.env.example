# Copy to .env.local to override. Files named .env*.local are git-ignored.

# Dev server only: where /api and /health requests are proxied to.
VITE_API_PROXY_TARGET=http://localhost:5184

# Base URL the browser uses for API calls. Leave empty to call the same origin
# (the dev proxy, or a reverse proxy in production). Set it only when the API
# is served from a different origin, e.g. https://api.example.com
VITE_API_BASE_URL=
